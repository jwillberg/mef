[Unit]
Description=mef daemon (auto-ban service)
Documentation=https://github.com/jwillberg/mef
After=network.target mef.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/mefdaemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
