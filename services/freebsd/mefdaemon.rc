#!/bin/sh
#
# PROVIDE: mefdaemon
# REQUIRE: NETWORKING mef
# KEYWORD: shutdown
#
# mefdaemon - dynamic IP banning service (fail2ban-style auto-ban)
# This is a standalone service - mef is NOT required
# If mef is enabled, it will run first to load firewall rules
#
# Add the following line to /etc/rc.conf to enable mefdaemon:
# mefdaemon_enable="YES"

. /etc/rc.subr

name="mefdaemon"
rcvar="mefdaemon_enable"

command="/usr/local/sbin/mefdaemon"
pidfile="/var/run/${name}.pid"
command_args=""

start_cmd="mefdaemon_start"
mefdaemon_start() {
  /usr/sbin/daemon -p "${pidfile}" "${command}" ${command_args}
}

load_rc_config $name
: ${mefdaemon_enable:="NO"}

run_rc_command "$1"
