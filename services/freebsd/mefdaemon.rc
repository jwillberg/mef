#!/bin/sh
# PROVIDE: mefdaemon
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="mefdaemon"
rcvar="mefdaemon_enable"

command="/usr/local/sbin/mefdaemon"
pidfile="/var/run/${name}.pid"
command_args=""

start_cmd="mefdaemon_start"
mefdaemon_start() {
  /usr/sbin/daemon -p "${pidfile}" "${command}" ${command_args}
}

load_rc_config $name
: ${mefdaemon_enable:="NO"}

run_rc_command "$1"
